# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/apartmento?retryWrites=true&w=majority

# Admin Authentication (REQUIRED - Do not use defaults in production)
# Support multiple admin users: comma-separated list of username:password
ADMIN_USERS="sihabali:your_secure_password_1,sanzid:your_secure_password_2"
ADMIN_JWT_SECRET=your_cryptographically_secure_hmac_secret_key_minimum_32_characters

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary Image Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Alternatively use the full CLOUDINARY_URL
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# IndexNow API Key for instant search engine indexing
INDEXNOW_KEY=your_indexnow_api_key
